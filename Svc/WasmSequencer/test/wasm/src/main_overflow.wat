;; Module whose `main` function overflows the guest stack at CALL SETUP.
;; The guest stack is 256 words. A main declaring 300 i64 locals needs ~600
;; words for its frame, which exceeds the stack before a single instruction
;; runs. moduleHasValidMain passes (the export exists with a valid [] -> []
;; signature; the local-count cap is well above 300 and locals do not
;; participate in operand-stack validation), but spacewasm_invoke returns a
;; StackOverflow trap at setup -> MAIN_INVOKE_CHECK else branch ->
;; reportModuleMainInvokeFailed + EXECUTION_ERROR -> IDLE.
(module
  (memory 1 (pagesize 1))
  (export "memory" (memory 0))
  (export "main" (func $main))
  (func $main
    (local i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64)
    (local i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64)
