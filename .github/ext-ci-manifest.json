{
  "upstream_repository": "nasa/fprime",
  "check_prefix": "ext-ci",
  "paths_ignore": [
    "docs/**",
    "**.md",
    ".github/actions/spelling/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/agents/**"
  ],
  "repos": [
    {
      "id": "led-blinker",
      "repository": "fprime-community/fprime-workshop-led-blinker",
      "workflow": "ci.yml",
      "default_ref": "devel",
      "timeout_minutes": 60,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    }
  ]
}
