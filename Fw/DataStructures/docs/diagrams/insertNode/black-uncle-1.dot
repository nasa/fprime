digraph {

  2 -> 1
  2 -> 4
  4 -> 3
  4 -> X [color="white"]

  1 -> BHn
  1 -> BHn

  4 -> BHnPlus1
  3 -> BHnPlus1
  3 -> BHnPlus1

  1 [label="1 (uncle)"]
  2 [label="2 (grandparent)",color="gray",fontcolor="gray"]
  4 [label="4 (parent)",color="red",fontcolor="red"]
  3 [color="red",fontcolor="red"]

  X [color="white",fontcolor="white"]

  BHn [shape="box",label="black height n",style="dotted",fontname="Italic"]
  BHnPlus1 [shape="box",label="black height n + 1",style="dotted",fontname="Italic"]
}
