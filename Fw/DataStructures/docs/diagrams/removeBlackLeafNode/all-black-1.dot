digraph {

  K4 -> K2
  K4 -> BHnPlus1
  K2 -> K1
  K2 -> K3

  K1 -> BHn
  K1 -> BHn
  K3 -> BHn
  K3 -> BHn

  K1 [label="K1 (distantNephew)"]
  K2 [label="K2 (sibling)"]
  K3 [label="K3 (closeNephew)"]
  K4 [label="K4 (parent)"]

  BHn [shape="box",label="black height n",style="dotted",fontname="Italic"]
  BHnPlus1 [shape="box",label="black height n + 1",style="dotted",fontname="Italic"]

}
