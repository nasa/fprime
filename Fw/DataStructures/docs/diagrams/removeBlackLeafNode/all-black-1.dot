digraph {

  K4 -> K2
  K4 -> BHiPlus1
  K2 -> K1
  K2 -> K3

  K1 -> BHi
  K1 -> BHi
  K3 -> BHi
  K3 -> BHi

  K1 [label="K1 (distantNephew)"]
  K2 [label="K2 (sibling)"]
  K3 [label="K3 (closeNephew)"]
  K4 [label="K4 (parent)"]

  BHi [shape="box",label="black height i",style="dotted",fontname="Italic"]
  BHiPlus1 [shape="box",label="black height i + 1",style="dotted",fontname="Italic"]

}
